# Modelo de variáveis de ambiente para desenvolvimento local do backend
# (Spring Boot) contra o Supabase local (`supabase start`).
#
# Copie este arquivo para backend/.env (não para a raiz do repositório!).
# O mvnw roda com CWD=backend/, e o spring.config.import em
# application.properties resolve ".env" relativo ao diretório de trabalho —
# um .env na raiz do repo NÃO é lido quando você roda
# `cd backend && ./mvnw spring-boot:run`.
#
# IMPORTANTE: `supabase start`/`stop` (start-dev.sh) precisam rodar num
# Git Bash NATIVO do Windows, fora do Dev Container — o Supabase CLI não
# funciona de dentro dele (ver comentário em start-dev.sh). O backend e o
# mobile, por sua vez, rodam DENTRO do Dev Container normalmente.
#
# Todos os valores abaixo vêm do que o `supabase start` imprime no terminal
# ao subir (mesmos valores sempre, em dev local — não mudam entre execuções
# a menos que você rode `supabase db reset` com um config.toml diferente).

# ----------------------------------------------------------------------------
# Banco de dados (application-local.yml lê DB_URL/DB_USER/DB_PASS, com
# fallback para localhost:54322 + postgres/postgres se ausentes — os mesmos
# valores padrão do Postgres local do Supabase, então geralmente você só
# precisa ADICIONAR host.docker.internal quando roda dentro do Dev Container).
#
# Onde pegar: seção "⛁ Database" da saída do `supabase start`
# (postgresql://postgres:postgres@127.0.0.1:54322/postgres) — usuário e
# senha são sempre "postgres" em dev local.
#
# - Fora do Dev Container (Maven nativo no Windows): pode deixar em branco,
#   os defaults de application-local.yml já funcionam.
# - Dentro do Dev Container: "localhost" é o loopback do próprio container,
#   não o do host Windows — use host.docker.internal (valores abaixo).
DB_URL=jdbc:postgresql://host.docker.internal:54322/postgres
DB_USER=postgres
DB_PASS=postgres

# Chave usada para assinar/validar os tokens JWT (HMAC256).
# Não vem de lugar nenhum — invente uma string longa e aleatória (ex.:
# rode `openssl rand -hex 32` no terminal). Só precisa ser consistente
# enquanto a aplicação estiver rodando.
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

# Supabase Storage — necessário para upload de imagens (perfil/portfólio).
#
# SUPABASE_URL — seção "🌐 APIs" -> "Project URL" da saída do `supabase start`
# (http://127.0.0.1:54321). Dentro do Dev Container, troque 127.0.0.1 por
# host.docker.internal (mesma lógica do banco acima).
#
# SUPABASE_SERVICE_ROLE_KEY — seção "🔑 Authentication Keys" -> "Secret"
# (sb_secret_...) da saída do `supabase start`. NÃO é a "Access Key"/
# "Secret Key" da seção "📦 Storage (S3)" — essa é para acesso via protocolo
# S3, outra finalidade.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=
